<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
      <h3 class="text-3xl mb-5">Uplod Profile Picture</h3>
      <form
        autocomplete="off"
        action="/upload"
        method="post"
        enctype="multipart/form-data"
      >
        <input class="rounded-md bg-red-300 mt-3" type="file" name="image" />
        <input
          class="px-5 py-2 rounded-md bg-blue-500"
          type="submit"
          value="Upload File"
        />
      </form>
    </div>
  </body>
</html>
