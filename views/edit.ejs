<!doctype html>

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
      <h5 class="mb-5">Edit your post</h5>

      <form action="/update/<%= post._id %>" method="post">
        <textarea
          name="content"
          placeholder="What's on your mind?"
          class="p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md"
        >
<%= post.content %></textarea
        >

        <input
          class="px-3 w-52 py-2 bg-yellow-500 text-black block rounded-md mt-2"
          type="submit"
          value="Update Post"
        />
      </form>
    </div>
  </body>
</html>
